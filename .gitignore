# macOS
.DS_Store

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Xcode — the project is generated from project.yml by xcodegen, so the
# generated bundles are build artifacts, not source. project.yml IS checked in.
*.xcodeproj
*.xcworkspace
DerivedData/
build/
xcuserdata/
*.xcuserstate

# Design handoff bundle — not source
compass-habit-tracker-design/

# Design handoff archives
*design-handoff.zip

# Python bytecode — the standalone verifier is a script, not a package, and its
# cache is a build artifact of running it.
__pycache__/
*.pyc
